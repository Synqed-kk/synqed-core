{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ],
  "crons": [
    {
      "path": "/v1/sync/cron/dispatch",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/v1/retention-signals/cron/sweep",
      "schedule": "0 18 * * *"
    }
  ],
  "regions": [
    "hnd1"
  ]
}