// =============================================================================
// KaruteOutcome — a session's coaching outcome label (success / no_deal /
// pending …), consolidated from the karute app DB. Keyed on the karute record
// (one outcome per record); the app upserts on karute_record_id.
// =============================================================================

model KaruteOutcome {
  karuteRecordId String    @id @map("karute_record_id") @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  // Plain text BY DESIGN — values today: 'success' | 'no_deal' | 'pending' |
  // 'revisit' (existing customer's normal visit). Do NOT tighten to an enum
  // (Liam 8/7): the app adds values app-layer first.
  // CLOSING RATE (authoritative): success / (success + no_deal).
  // 'revisit' and 'pending' are excluded from BOTH numerator and denominator.
  outcome        String
  reason         String?
  // Which question set the staff answered: 'conversion' (first-visit close)
  // vs 'repurchase'. Without it, re-opening a past outcome shows the wrong
  // questions.
  decisionContext String?  @map("decision_context")
  isFirstVisit   Boolean   @default(false) @map("is_first_visit")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz()
  autoDecided    Boolean   @default(false) @map("auto_decided")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([businessId])
  @@index([businessId, outcome, updatedAt])
  @@map("karute_outcomes")
}

