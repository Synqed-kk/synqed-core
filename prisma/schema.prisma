// =============================================================================
// IdempotencyKey — dedup store for retried appointment creates. Claim row is
// inserted before the create and completed with the appointment id after; a
// duplicate request replays the stored appointment instead of double-booking.
// =============================================================================

model IdempotencyKey {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  // Which endpoint family owns the key ('appointment' | 'photo' | ...) — the
  // same client key can exist under different scopes without colliding.
  scope      String   @default("appointment")
  key        String
  // The created row's id (appointment, photo, ...) — replay returns it.
  targetId   String?  @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([businessId, scope, key])
  @@map("idempotency_keys")
}

