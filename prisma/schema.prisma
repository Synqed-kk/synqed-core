// =============================================================================
// PricingRuleSet — WHEN the price moves inside the menu band (menus own the
// band itself: price_list = ceiling, price_min = floor). Per store × menu
// (menu NULL = the store-wide default set), append-only versions: saving
// supersedes the previous ACTIVE row, rollback re-issues an old version as a
// new one — price history stays reconstructable and rollback is one write.
// scope_type is future-proofing for store GROUPS (urban/suburban tiers).
// =============================================================================

enum PricingScopeType {
  STORE
}

enum PricingRuleStatus {
  ACTIVE
  SUPERSEDED
}

model PricingRuleSet {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @map("business_id") @db.Uuid
  scopeType  PricingScopeType  @default(STORE) @map("scope_type")
  storeId    String            @map("store_id") @db.Uuid
  menuId     String?           @map("menu_id") @db.Uuid
  version    Int
  status     PricingRuleStatus @default(ACTIVE)
  // { grid?: {mon..sun: {"0".."23": mult}}, promos?: [{from,to,multiplier,label?}], flex? }
  rules      Json
  createdBy  String?           @map("created_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  @@index([businessId, storeId, menuId, status])
  @@map("pricing_rule_sets")
}

// =============================================================================
// StoreBookingPolicy — per-store booking-acceptance terms (Liam item 3): how
// far ahead bookings open, the same-day cutoff, and cancellation fee terms.
// One row per store; absent row = platform defaults (see policy.service).
// Reserve's BFF reads this when it builds the public calendar; the Business
// dashboard edits it (HQ-gated). These lived hardcoded in the reserve app.
// =============================================================================

enum GapGuardMode {
  OFF
  STANDARD
  STRICT
}

model StoreBookingPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  storeId              String   @unique @map("store_id") @db.Uuid
  // How many days ahead a customer can book (calendar horizon).
  bookingOpenDays      Int      @default(30) @map("booking_open_days")
  // Bookings must be made at least this many minutes before the slot.
  cutoffMinutes        Int      @default(0) @map("cutoff_minutes")
  // Cancellation is free until N hours before the start...
  cancelFreeUntilHours Int      @default(24) @map("cancel_free_until_hours")
  // ...then this % of the booked price applies, and no-show pays this %.
  cancelLatePct        Int      @default(0) @map("cancel_late_pct")
  noShowPct            Int      @default(0) @map("no_show_pct")
  // スキマガード Phase 1 (HANDOFF-2026-08-13): policy fields only — NOTHING
  // enforces yet; the engine (gap-guard-engine.ts) has no callers. OFF =
  // engine not invoked. Lead time deliberately REUSES cutoff_minutes.
  // PORT TRAP: normalize this enum BEFORE any future engine call — the frozen
  // engine treats unknown mode strings as 'standard'.
  gapGuardMode            GapGuardMode @default(OFF) @map("gap_guard_mode")
  newClientSessionMinutes Int          @default(90) @map("new_client_session_minutes")
  updatedBy            String?  @map("updated_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([businessId])
  @@map("store_booking_policies")
}

// =============================================================================
// RecordingDiscardEvent — one row per discard of a recording. The written
// reason is CONTENT (it lives here, never in the audit log — audit rows
// reference this row's id in detail instead). Discarding is abnormal: a staff
// discard REQUIRES a written explanation; system cleanup rows carry none
// (Liam's 8/17 correction — the reason-category menu is gone, the category is
// exactly staff-vs-system). No FK to recording_sessions on purpose: the
// session row is hard-deleted and this ledger must outlive it.
// =============================================================================

enum RecordingDiscardSource {
  STAFF
  SYSTEM
}

model RecordingDiscardEvent {
  id                 String                 @id @default(uuid()) @db.Uuid
  businessId         String                 @map("business_id") @db.Uuid
  recordingSessionId String                 @map("recording_session_id") @db.Uuid
  source             RecordingDiscardSource
  // Staff card id (either identity form accepted at the API, stored under the
  // card). NULL exactly when source = SYSTEM.
  discardedBy        String?                @map("discarded_by") @db.Uuid
  // REQUIRED (non-blank) for STAFF, NULL for SYSTEM — DB CHECK enforced.
  reason             String?
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  @@index([businessId, recordingSessionId])
  @@index([businessId, createdAt])
  @@map("recording_discard_events")
}

// =============================================================================
// RetentionSignal — the 引き抜き-detection lane's store (NEUTRAL name on
// purpose: legal review bars poaching-style labels anywhere in schema). A
// possibly-wrong AI inference about a NAMED customer, so this store deviates
// from the soft-delete house pattern BY RULING: dismissal/expiry/statutory
// demand HARD-delete the row (content must not survive), while the app writes
// normal audit events (ids+flags only) so the fact of flag-and-discard is
// permanently logged. Customer relation cascades — a deleted customer's
// signals erase with them (the scrub inclusion the spec requires).
// Legal walls, not preferences: NO staff scores/flags, NO "LINE exchanged"
// boolean, NO free text beyond the verbatim transcript quote.
// =============================================================================

enum RetentionSignalStatus {
  pending
  confirmed
}

model RetentionSignal {
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @map("business_id") @db.Uuid
  status            RetentionSignalStatus @default(pending)
  occurredAt        DateTime              @map("occurred_at") @db.Timestamptz()
  // Factual anchor — plain uuid (karute records can be deleted independently).
  karuteRecordId    String                @map("karute_record_id") @db.Uuid
  customerId        String                @map("customer_id") @db.Uuid
  staffId           String                @map("staff_id") @db.Uuid
  // Which WRITTEN detection rule fired — regulator-style auditability.
  criterion         String
  confidence        String
  // The customer's verbatim sentence (app-validated transcript substring).
  quote             String
  mentionedBusiness String?               @map("mentioned_business")
  confirmedBy       String?               @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime?             @map("confirmed_at") @db.Timestamptz()
  // pending: review TTL (default 14d — unreviewed rows auto-erase);
  // confirmed: retention clock (default 1y, final value pending counsel).
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz()
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz()

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, status, expiresAt])
  @@index([businessId, createdAt])
  @@map("retention_signals")
}

// Anonymized dismissal counters — audits the detection rules for over-firing.
// business scoping only; NO personal ids, NO quote (the content must not
// survive a dismissal).
model RetentionSignalDismissal {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  criterion   String
  confidence  String
  dismissedAt DateTime @default(now()) @map("dismissed_at") @db.Timestamptz()

  @@index([businessId, dismissedAt])
  @@map("retention_signal_dismissals")
}
