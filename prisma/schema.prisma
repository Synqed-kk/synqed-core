generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Customer — core business-scoped entity
// =============================================================================

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  // Soft delete (30-day recoverable window). Reads exclude deleted rows by
  // default; restore = null it inside the window; day-30 hard delete runs the
  // audit scrub. Never instant-delete (Liam ruling 2026-07-17).
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()
  name            String
  furigana        String?
  email           String?
  phone           String?
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?
  occupation            String?  @map("occupation")
  memberNumber          String?  @map("member_number")
  postalCode            String?  @map("postal_code")
  prefecture            String?
  address               String?
  phone2                String?
  dmOptIn               Boolean  @default(false) @map("dm_opt_in")
  comment               String?
  remarks2              String?
  totalSales            Int      @default(0) @map("total_sales")
  installmentOutstanding Int     @default(0) @map("installment_outstanding")
  hasTicketPack         Boolean  @default(false) @map("has_ticket_pack")
  firstVisitAt          DateTime? @map("first_visit_at") @db.Timestamptz()
  lastVisitAt           DateTime? @map("last_visit_at") @db.Timestamptz()
  locale          String   @default("ja")
  notes           String?
  contactInfo     String?  @map("contact_info")
  assignedStaffId String?  @map("assigned_staff_id") @db.Uuid
  // Returning-customer signal + lifetime visit count. Populated by external
  // syncs (e.g. QuickReserve's is_existing_customer / visits_number_cache);
  // default to first-time / 0 for customers created in-app.
  isExistingCustomer Boolean @default(false) @map("is_existing_customer")
  visitCount         Int     @default(0) @map("visit_count")
  // Per-business sequential chart number (カルテNo). Assigned at create
  // (max+1 within the business); the manual migration backfills existing
  // rows by created_at. Display formatting (#00001) is the app's job.
  karuteNumber       Int?    @map("karute_number")
  // External system references (e.g. { quickreserve: { customerId: 12345 } })
  externalRefs    Json     @default("{}") @map("external_refs")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  appointments Appointment[]
  photos       CustomerPhoto[]
  consents     RecordingConsent[]
  visits       CustomerVisit[]
  retentionSignals RetentionSignal[]
  entryEdits   KaruteEntryEdit[]

  @@unique([businessId, email])
  @@unique([businessId, karuteNumber])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, email])
  @@map("customers")
}

// =============================================================================
// CustomerVisit — one row per QuickReserve reservation, crawled into synqed-core
// to surface a customer's visit / treatment / sales history.
// =============================================================================

model CustomerVisit {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  storeId          String?  @map("store_id") @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  qrReservationId  Int      @map("qr_reservation_id")
  usedAt           DateTime @map("used_at") @db.Timestamptz()
  status           String   // 'settled' | 'booked' | 'cancelled'
  courseName       String?  @map("course_name")
  salesAmount      Int      @default(0) @map("sales_amount")
  staffName        String?  @map("staff_name")
  treatmentComment String?  @map("treatment_comment")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, qrReservationId])
  @@index([customerId, usedAt])
  @@index([businessId, storeId])
  @@map("customer_visits")
}

// =============================================================================
// RecordingConsent — per-customer recording consent for APPI / privacy compliance.
// One active row per customer (revoked rows preserved for audit).
// =============================================================================

enum ConsentMethod {
  VERBAL
  WRITTEN
}

model RecordingConsent {
  id                 String        @id @default(uuid()) @db.Uuid
  businessId         String        @map("business_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  grantedByStaffId   String        @map("granted_by_staff_id") @db.Uuid
  grantedAt          DateTime      @default(now()) @map("granted_at") @db.Timestamptz()
  method             ConsentMethod @default(VERBAL)
  policyVersion      String        @map("policy_version")
  revokedAt          DateTime?     @map("revoked_at") @db.Timestamptz()
  revokedByStaffId   String?       @map("revoked_by_staff_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId, revokedAt])
  @@map("recording_consents")
}

// =============================================================================
// CustomerPhoto — per-customer photo metadata; bytes live in Supabase Storage
// =============================================================================

model CustomerPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  storagePath String   @map("storage_path")
  category    String   @default("general")
  caption     String?
  // Session linkage (photo-session design 2026-08-02): photos taken DURING a
  // session carry where/who/consent. All optional — pre-linkage clients and
  // rows are untouched. Session delete keeps the photo (SET NULL).
  recordingSessionId String?  @map("recording_session_id") @db.Uuid
  capturedByStaffId  String?  @map("captured_by_staff_id") @db.Uuid
  takenWithConsent   Boolean  @default(false) @map("taken_with_consent")
  // Soft delete (Liam 8/16): staff self-delete of mis-shots is only safe if
  // nothing is ever truly gone. Storage file is KEPT — no purge in v1 (a real
  // purge is a deliberate later decision; customers-style 30-day undo is
  // handled app-side).
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy   String?   @map("deleted_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordingSession RecordingSession? @relation(fields: [recordingSessionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId, createdAt])
  @@index([recordingSessionId])
  @@map("customer_photos")
}

// =============================================================================
// Staff — business members who take bookings / do karute
// =============================================================================

enum StaffRole {
  OWNER
  ADMIN
  STYLIST
  ASSISTANT
}

model Staff {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  userId     String?   @unique @map("user_id") @db.Uuid
  name       String
  nameKana   String?   @map("name_kana")
  email      String?
  role       StaffRole @default(STYLIST)
  isActive   Boolean   @default(true) @map("is_active")
  pinHash    String?   @map("pin_hash")
  avatarUrl  String?   @map("avatar_url")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  appointments Appointment[]

  @@index([businessId])
  @@index([businessId, name])
  @@map("staff")
}

// =============================================================================
// Appointment — booking from any source (manual or skimmed from Quick Reserve etc.)
// =============================================================================

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Who last set an appointment's status. STAFF-set terminal statuses win over
// the QuickReserve crawl (it must never flip a staff cancel/no-show back).
enum StatusSource {
  SYSTEM
  QR
  STAFF
}

enum AppointmentSource {
  MANUAL
  QUICKRESERVE
  SYNQED_RESERVE
  SALON_BOARD
  HOT_PEPPER
  OTHER
}

// =============================================================================
// Menu — the bookable service catalog (SYNQED Reserve's menu source of truth).
// Shaped to serve the Reserve customer contract (MenuPublic) + the band
// pricing engine: price_list = the 税込 list price (= band ceiling, the
// display baseline); price_min = the band floor (NULL = fixed price, no
// discounting). Money is integer minor-unit-free amounts + explicit currency —
// never a hardcoded yen assumption (multi-country roadmap).
// =============================================================================
model Menu {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  // NULL = offered at every store; set = store-specific menu.
  storeId              String?  @map("store_id") @db.Uuid
  name                 String
  description          String?
  category             String?
  // Owner-set section order for the booking UI — course displayOrder alone
  // can't express it (courses interleave across categories).
  categoryDisplayOrder Int      @default(0) @map("category_display_order")
  displayOrder         Int      @default(0) @map("display_order")
  durationMinutes      Int      @map("duration_minutes")
  priceListAmount      Int      @map("price_list_amount")
  priceMinAmount       Int?     @map("price_min_amount")
  currency             String   @default("JPY")
  taxIncluded          Boolean  @default(true) @map("tax_included")
  // 指名 offered for THIS menu (first-visit menus typically false — the
  // customer flow then never shows staff and rejects staffed writes).
  nominationAllowed    Boolean  @default(true) @map("nomination_allowed")
  // Visible on the public booking surface (vs staff-side-only menus).
  onlineVisible        Boolean  @default(true) @map("online_visible")
  // Retirement flag — menus are never hard-deleted (booked appointments
  // reference them; house rule: no hard delete).
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([businessId, active])
  @@index([businessId, storeId])
  @@map("menus")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  storeId         String?           @map("store_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  staffId         String            @map("staff_id") @db.Uuid
  startsAt        DateTime          @map("starts_at") @db.Timestamptz()
  endsAt          DateTime          @map("ends_at") @db.Timestamptz()
  durationMinutes Int?              @map("duration_minutes")
  title           String?
  notes           String?
  // The booked menu + the price the customer AGREED TO at booking time —
  // a snapshot, deliberately not an FK (menu edits/retirement must never
  // rewrite what an existing booking promised). NULL on rows that predate
  // menus or come from writers without catalog context (QR crawl, manual).
  menuId              String? @map("menu_id") @db.Uuid
  bookedPriceAmount   Int?    @map("booked_price_amount")
  bookedPriceCurrency String? @map("booked_price_currency")
  status          AppointmentStatus @default(SCHEDULED)
  source          AppointmentSource @default(MANUAL)
  // External system references. Shape: { quickreserve: { reservationId: 12345, rid: "abc" } }
  externalRefs    Json              @default("{}") @map("external_refs")
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz()
  // Status audit + sync-win. status_source=STAFF marks a human decision the
  // crawl must not overwrite; the rest is the who/why/when audit trail.
  statusSource    StatusSource      @default(SYSTEM) @map("status_source")
  statusSetBy     String?           @map("status_set_by") @db.Uuid
  statusReason    String?           @map("status_reason")
  statusSetAt     DateTime?         @map("status_set_at") @db.Timestamptz()
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  customer Customer @relation(fields: [customerId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])

  @@index([businessId, startsAt])
  @@index([customerId, startsAt])
  @@index([staffId, startsAt])
  // External-ref-based dedup for upserts
  @@index([businessId, source])
  @@index([businessId, storeId])
  // One ACTIVE booking per customer-slot. A customer cannot start two sessions
  // at the same instant, so this is the hard guarantee that the QR crawl (or a
  // slow-wifi save retry) can never mint a second row for the same visit —
  // "one visit showing as two bookings." A genuine back-to-back double session
  // has a DIFFERENT startsAt and is unaffected. Enforced-adopt on conflict in
  // runQuickReserveSync claims the existing row instead of duplicating.
  //
  // This is a PARTIAL unique index (WHERE status NOT IN ('CANCELLED','NO_SHOW'))
  // — a terminal booking frees its slot so the customer can rebook it. Prisma
  // can't express partial uniqueness, so it lives in the manual migration
  // 2026-07-06-appointment-active-slot-partial.sql, not as an @@unique here.
  // Nothing in code does a compound findUnique on this key (adopt uses findFirst).
  // With @@unique gone, P2002 reports the raw index NAME, so that name contains
  // "starts_at" and isUniqueViolation(e, 'starts_at') still matches (adopt + 409).
  @@map("appointments")
}

// =============================================================================
// SyncConfig — per-business external booking system integration config
// =============================================================================

enum SyncProvider {
  QUICKRESERVE
  SYNQED_RESERVE
  SALON_BOARD
  HOT_PEPPER
}

enum SyncStatus {
  OK
  ERROR
  RUNNING
}

model SyncConfig {
  id                   String       @id @default(uuid()) @db.Uuid
  businessId           String       @map("business_id") @db.Uuid
  provider             SyncProvider
  // Encrypted credentials (AES-256-GCM). Shape of decrypted payload depends on provider.
  // For QUICKRESERVE: { username, password, storeSlug, storeId }
  credentialsEncrypted Bytes?       @map("credentials_encrypted")
  // Non-secret config that the UI displays / edits
  username             String?
  storeSlug            String?      @map("store_slug")
  storeId              Int?         @map("store_id")
  // Karute LOCATION (uuid) this QR config feeds — synced events get stamped with it.
  // Distinct from storeId above (the QR API's numeric store id).
  karuteStoreId        String?      @map("karute_store_id") @db.Uuid
  // Scheduling
  enabled              Boolean      @default(false)
  intervalMinutes      Int          @default(15) @map("interval_minutes")
  businessHoursStart   Int          @default(8) @map("business_hours_start") // hour 0-23
  businessHoursEnd     Int          @default(22) @map("business_hours_end") // hour 0-23
  timezone             String       @default("Asia/Tokyo")
  // Date window: how many days forward to sync (today = 0, tomorrow = 1, ...)
  lookaheadDays        Int          @default(7) @map("lookahead_days")
  // Status
  lastRunAt            DateTime?    @map("last_run_at") @db.Timestamptz()
  lastRunStatus        SyncStatus?  @map("last_run_status")
  lastRunError         String?      @map("last_run_error")
  lastRunStats         Json         @default("{}") @map("last_run_stats") // { created, updated, cancelled, skipped, unmatchedStaff[] }
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([businessId, provider])
  @@index([enabled, lastRunAt])
  @@map("sync_configs")
}

// =============================================================================
// RecordingSession — audio capture + transcription lifecycle
// =============================================================================

enum RecordingStatus {
  RECORDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model RecordingSession {
  id               String          @id @default(uuid()) @db.Uuid
  businessId       String          @map("business_id") @db.Uuid
  storeId          String?         @map("store_id") @db.Uuid
  customerId       String?         @map("customer_id") @db.Uuid
  staffId          String          @map("staff_id") @db.Uuid
  appointmentId    String?         @map("appointment_id") @db.Uuid
  audioStoragePath String?         @map("audio_storage_path")
  durationSeconds  Int?            @map("duration_seconds")
  status           RecordingStatus @default(RECORDING)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  segments     TranscriptionSegment[]
  karuteRecord KaruteRecord?
  photos       CustomerPhoto[]

  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([staffId])
  @@index([businessId, storeId])
  @@map("recording_sessions")
}

// =============================================================================
// TranscriptionSegment — ordered chunks of transcript for a recording
// =============================================================================

model TranscriptionSegment {
  id                 String   @id @default(uuid()) @db.Uuid
  recordingSessionId String   @map("recording_session_id") @db.Uuid
  segmentIndex       Int      @map("segment_index")
  text               String
  startTime          Float    @map("start_time")
  endTime            Float    @map("end_time")
  speakerLabel       String?  @map("speaker_label")
  confidence         Float?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  recordingSession RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)

  @@index([recordingSessionId, segmentIndex])
  @@map("transcription_segments")
}

// =============================================================================
// KaruteRecord — per-session clinical/service notes (header)
// =============================================================================

enum KaruteStatus {
  DRAFT
  REVIEW
  APPROVED
}

model KaruteRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  businessId         String       @map("business_id") @db.Uuid
  storeId            String?      @map("store_id") @db.Uuid
  customerId         String?      @map("customer_id") @db.Uuid
  staffId            String       @map("staff_id") @db.Uuid
  lastEditedByStaffId String?     @map("last_edited_by_staff_id") @db.Uuid
  appointmentId      String?      @map("appointment_id") @db.Uuid
  recordingSessionId String?      @unique @map("recording_session_id") @db.Uuid
  status             KaruteStatus @default(DRAFT)
  aiSummary          String?      @map("ai_summary")
  transcript         String?
  // Session metadata captured by the manual-create dialog (and later the
  // recording flow): what was performed, how long, and the actual session
  // day (backdating support — createdAt is the row insert time).
  service            String?
  durationMinutes    Int?         @map("duration_minutes")
  sessionDate        DateTime?    @map("session_date") @db.Date
  // Human overlay on aiSummary (the pencil). Readers use edited ?? ai; NO AI
  // path ever writes it — regen keeps overwriting aiSummary and this survives.
  editedSummary      String?      @map("edited_summary")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  entries          KaruteEntry[]
  recordingSession RecordingSession? @relation(fields: [recordingSessionId], references: [id])

  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([staffId])
  @@index([businessId, storeId])
  @@map("karute_records")
}

// =============================================================================
// KaruteEntry — categorized items inside a karute record
// =============================================================================

enum EntryCategory {
  SYMPTOM
  TREATMENT
  BODY_AREA
  PREFERENCE
  LIFESTYLE
  NEXT_VISIT
  PRODUCT
  OTHER
}

// Entry provenance: richer than isManual (kept for back-compat — it means
// "human_created" exactly). AI → HUMAN_EDITED is a one-way door; the AI's
// original text survives in originalAiContent.
enum EntryAuthor {
  AI
  HUMAN_EDITED
  HUMAN_CREATED
}

model KaruteEntry {
  id             String        @id @default(uuid()) @db.Uuid
  karuteRecordId String        @map("karute_record_id") @db.Uuid
  category       EntryCategory
  content        String
  originalQuote  String?       @map("original_quote")
  confidence     Float         @default(0)
  tags           String[]      @default([])
  sortOrder      Int           @default(0) @map("sort_order")
  isManual       Boolean       @default(false) @map("is_manual")
  author         EntryAuthor   @default(AI)
  // The AI's text as first extracted — set on the FIRST human edit of an AI
  // entry and never overwritten, so the original always survives.
  originalAiContent String?    @map("original_ai_content")
  // Optimistic concurrency: updateEntry requires the caller's expected_version
  // and 409s on mismatch (edit-vs-edit, edit-vs-regen races).
  version        Int           @default(1)
  // Soft delete: hidden from reads, never vanishes (customer-memory pattern).
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz()
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  karuteRecord KaruteRecord @relation(fields: [karuteRecordId], references: [id], onDelete: Cascade)

  @@index([karuteRecordId, sortOrder])
  @@map("karute_entries")
}

// =============================================================================
// KaruteEntryEdit — append-only audit + correction-pair log (the 監査ログ).
// Written in the SAME transaction as every entry mutation. Doubles as the
// eval/improvement dataset (subject to the per-business opt-out in
// org_settings.settings.correction_data_opt_out). In-house use only — never
// sent to model vendors (ToS/DPA line ships with the feature).
// =============================================================================

enum EntryEditAction {
  CREATE
  EDIT
  DELETE
  REGEN_REPLACE
  ADOPT_AI
  DISMISS_AI
}

model KaruteEntryEdit {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  // Lineage for privacy cascade: deleting the customer deletes their
  // correction rows too. Nullable — record-level edits may have no customer.
  customerId     String?         @map("customer_id") @db.Uuid
  // Plain uuid, NO FK: the audit trail must survive record deletion.
  karuteRecordId String          @map("karute_record_id") @db.Uuid
  entryIdOld     String?         @map("entry_id_old") @db.Uuid
  entryIdNew     String?         @map("entry_id_new") @db.Uuid
  actorStaffId   String?         @map("actor_staff_id") @db.Uuid
  action         EntryEditAction
  category       EntryCategory?
  contentBefore  String?         @map("content_before")
  contentAfter   String?         @map("content_after")
  authorBefore   EntryAuthor?    @map("author_before")
  authorAfter    EntryAuthor?    @map("author_after")
  // Groups one regen into ONE event (a regen is ~15 rows otherwise).
  batchId        String?         @map("batch_id") @db.Uuid
  // Stamped at write time so corrections attribute to prompt versions.
  promptVersion  String?         @map("prompt_version")
  model          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([karuteRecordId])
  @@index([batchId])
  @@map("karute_entry_edits")
}

// =============================================================================
// OrgSettings — per-business config bag (replaces karute's Organization.settings JSON)
// =============================================================================

model OrgSettings {
  businessId String   @id @map("business_id") @db.Uuid
  name       String?
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("org_settings")
}

// =============================================================================
// RecordingJob — server-side recording→karute pipeline state (Liam ask
// 2026-07-19). The job row is the durable anchor: the client uploads audio,
// enqueues, and polls; a karute-side worker claims and runs
// transcribe→extract→summarize→save. UNIQUE(recording_session_id) is the
// idempotency rail — re-enqueue of the same recording returns the same job.
// Claim/complete/fail are cross-tenant (trusted server key) because the worker
// sweeps all businesses; enqueue/status are tenant-scoped.
// =============================================================================

enum RecordingJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model RecordingJob {
  id                 String             @id @default(uuid()) @db.Uuid
  businessId         String             @map("business_id") @db.Uuid
  recordingSessionId String             @unique @map("recording_session_id") @db.Uuid
  status             RecordingJobStatus @default(QUEUED)
  attempts           Int                @default(0)
  maxAttempts        Int                @default(3) @map("max_attempts")
  lastError          String?            @map("last_error")
  // Everything the worker needs to run without the client: audio path, the
  // save inputs, the acting staff. Shape owned by the karute worker.
  payload            Json
  karuteRecordId     String?            @map("karute_record_id") @db.Uuid
  claimedAt          DateTime?          @map("claimed_at") @db.Timestamptz()
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, createdAt])
  @@index([businessId, createdAt])
  @@map("recording_jobs")
}

// =============================================================================
// AuditLog — the real 監査ログ: who opened/edited/deleted/exported what.
// Append-only, ENFORCED IN THE DB by a trigger (audit_log_block_mutation) —
// the single exception is the SECURITY DEFINER erasure scrub
// (audit_log_scrub_customer), which sets the session flag the trigger checks.
// NO FKs on actor_id/target_id ON PURPOSE: inserts must never take locks on
// customers/staff rows, and deletes must never fight the log. entry-level
// before/after diffs stay in karute_entry_edits; an edit's audit row carries
// entry_edit_id in `detail` to link them. Wave 3 (login/auth events) flows in
// through the same shape — category is an open string, don't design it shut.
// =============================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  storeId     String?  @map("store_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz()
  actorId     String?  @map("actor_id") @db.Uuid
  actorType   String   @map("actor_type") // staff | owner | system | dev
  actorRole   String?  @map("actor_role")
  // Write-time SNAPSHOT of the actor's display name (like target_label) — a
  // deleted staff member's history keeps their name instead of showing 不明.
  // Deliberately no FK, deliberately not resolved at read time.
  actorLabel  String?  @map("actor_label")
  category    String // e.g. customer | karute | export | settings | permission | auth
  action      String // e.g. view | edit | delete | restore | export | pin_change
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  detail      Json?
  // Owner/dev cross-access flag — "show me every privileged access" is one query.
  breakGlass  Boolean  @default(false) @map("break_glass")
  severity    String   @default("info") // info | warn | critical
  // Durable actor identity = the permanent staff CARD id (assignments store
  // under the card even when actor_id is a login uuid — see logEvent). Real
  // column, not detail JSON: labels collide and detail is scrubbed on
  // customer deletion.
  actorStaffRef String? @map("actor_staff_ref") @db.Uuid
  // Correlates the several rows one action writes (mutation + views etc.).
  requestId     String? @map("request_id")

  @@index([businessId, at])
  @@index([businessId, actorId, at])
  @@index([businessId, actorStaffRef, at])
  @@index([businessId, targetType, targetId, at])
  @@index([businessId, category, at])
  @@map("audit_log")
}

